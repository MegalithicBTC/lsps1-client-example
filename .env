# Megalith LSPS1 client configuration. Nothing in here is secret.
# Docs: https://docs.megalithic.me/lightning-services/lsp1-get-inbound-liquidity-for-mobile-clients/
# Spec: https://github.com/lightning/blips/blob/master/blip-0051.md

# Megalith LSPS1 API (mainnet). Megalith takes the bLIP-51 requests as JSON over
# HTTPS: GET get_info, POST create_order, GET get_order.
LSPS1_API_URL=https://megalithic.me/api/lsps1/v1

# Megalith's LSPS1 node (mainnet), one of the "uris" in get_info. Your node
# connects here before ordering, and this node opens your channel. The program
# checks it is still listed in get_info before it orders.
# Node URI: 038a9e56512ec98da2b5789761f7af8f280baf98a09282360cd6ff1381b5e889bf@64.23.162.51:9735
LSP_PUBKEY=038a9e56512ec98da2b5789761f7af8f280baf98a09282360cd6ff1381b5e889bf
LSP_ADDRESS=64.23.162.51:9735

# Sent as the order's "token". Any non-empty string works.
LSP_TOKEN=lsps1-client-example

# Size of the channel to buy, in sats. All of it is inbound liquidity: the LSP's
# side of the channel, which is what lets your node receive. Must be within
# get_info's bounds (150,000 to 16,000,000 sats as of this writing).
CHANNEL_SIZE_SATS=250000

# Bitcoin network: bitcoin, testnet, regtest, signet (the LSP above is on mainnet)
NETWORK=bitcoin

# Esplora API endpoint for blockchain data
ESPLORA_API_URL=https://blockstream.info/api

# Rapid Gossip Sync server: downloads the public channel graph so the node can
# find routes past the LSP when it pays. Without it the node falls back to slow
# P2P gossip.
RGS_SERVER_URL=https://rapidsync.lightningdevkit.org/snapshot

# Where node state, logs and the saved order live
STORAGE_DIR=tmp

# Log level: Trace, Debug, Info, Warn, Error
LOG_LEVEL=Debug
