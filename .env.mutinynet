# Mutinynet (signet) configuration, used when you pass --mutinynet:
#   cargo run -- --mutinynet
# Values here win over .env; anything not set here comes from .env.

# Megalith LSPS1 API and node on Mutinynet (different node from mainnet)
LSPS1_API_URL=https://lsp1.mutiny.megalith-node.com/api/lsps1/v1
LSP_PUBKEY=03e30fda71887a916ef5548a4d02b06fe04aaa1a8de9e24134ce7f139cf79d7579
LSP_ADDRESS=64.23.192.68:9736

# Mutinynet is a custom signet
NETWORK=signet
ESPLORA_API_URL=https://mutinynet.com/api
RGS_SERVER_URL=https://rgs.mutinynet.com/snapshot

# Separate dir so mainnet state in tmp/ isn't mixed in
STORAGE_DIR=tmp_mutinynet
